# =============================================================================
# Oridecon Monorepo — Import-Linter Boundary Contracts
# =============================================================================
#
# IMPORTANT: Run via the namespace-aware wrapper, NOT the bare lint-imports
# binary.  The standard lint-imports/grimp binary cannot traverse
# pkgutil.extend_path namespace packages and will fail to discover extension
# packages (oridecon.contracts, oridecon.cache, etc.).
#
#   ✅  uv run lint-boundaries        (Makefile target / uv script)
#   ✅  uv run python tools/lint_imports.py
#   ❌  uv run lint-imports           (misses namespace extension dirs)
#
# Package boundary rules (from AGENTS.md)
# ----------------------------------------
#
#   oridecon-contracts  → zero dependencies; Protocols, types, exceptions only
#            ↑   ↑
#            ↑  oridecon (core)  → depends ONLY on oridecon.contracts
#            ↑   ↑
#            oridecon-*  → extension packages; depend on oridecon +
#                          oridecon.contracts and the four Phase-8
#                          foundational packages; NEVER on each other
#
# Foundational packages (Phase 8)
# --------------------------------
# oridecon.domain, oridecon.serialization, oridecon.validation,
# oridecon.concurrency are mid-tier foundations that ALL extensions
# are permitted to import.  They must NOT import from non-foundational
# extension packages (verified by contract: foundational-no-high-level).
#
# Composite packages (by design, broad access)
# ----------------------------------------------
# oridecon.admin, oridecon.cli, oridecon.testing are high-level composite
# packages that intentionally import from many extensions and are therefore
# excluded from the extension-independence contract.  oridecon.ai is the
# AI orchestrator/facade and is excluded for the same reason.
#
# Documented cross-extension allowances
# ---------------------------------------
# • oridecon.admin  → oridecon.ui    (same-subsystem UI components)
# • oridecon.web    → oridecon.ui    (same-subsystem UI rendering)
# • oridecon.web    → oridecon.security  [TRACKED VIOLATION — web's security
#   middleware depends on oridecon.security; should be refactored to use
#   oridecon.contracts for the interface boundary]
# • oridecon.ai     → oridecon.ai.* + oridecon.vector (orchestrator imports
#   sub-packages and vector store for composition)
# • oridecon.vector → * (unrestricted; foundational data structure)
#
# =============================================================================

[importlinter]
root_packages =
    oridecon
include_typechecking_imports = True

# =============================================================================
# Contract 1 — oridecon.contracts has zero ecosystem dependencies
# =============================================================================
# The contracts layer is a pure-protocol layer.  It must never import from
# the core framework, any extension package, or any AI sub-package.

[importlinter:contract:contracts-zero-deps]
name = oridecon.contracts has no ecosystem imports
type = forbidden
source_modules =
    oridecon.contracts
forbidden_modules =
    # Core package sub-modules
    oridecon.app
    oridecon.config
    oridecon.primitives
    oridecon.di
    oridecon.logging
    oridecon.result
    # Non-AI extension packages
    oridecon.admin
    oridecon.auth
    oridecon.cache
    oridecon.cli
    oridecon.concurrency
    oridecon.domain
    oridecon.events
    oridecon.features
    oridecon.graph
    oridecon.graphql
    oridecon.http
    oridecon.mapping
    oridecon.middleware
    oridecon.monitor
    oridecon.nosql
    oridecon.notification
    oridecon.plugins
    oridecon.queue
    oridecon.resilience
    oridecon.search
    oridecon.security
    oridecon.serialization
    oridecon.sql
    oridecon.storage
    oridecon.tasks
    oridecon.testing
    oridecon.ui
    oridecon.validation
    oridecon.vector
    oridecon.web
    oridecon.workflow
    # AI family
    oridecon.ai

# =============================================================================
# Contract 2 — Core framework does not import from extension packages
# =============================================================================
# The core oridecon package (app, config, core, di, logging, result) may
# ONLY import from oridecon.contracts and the Python standard library.

[importlinter:contract:core-no-extensions]
name = Core (oridecon) does not import from extension packages
type = forbidden
source_modules =
    oridecon.app
    oridecon.config
    oridecon.primitives
    oridecon.di
    oridecon.logging
    oridecon.result
forbidden_modules =
    # Non-AI extension packages
    oridecon.admin
    oridecon.auth
    oridecon.cache
    oridecon.cli
    oridecon.concurrency
    oridecon.domain
    oridecon.events
    oridecon.features
    oridecon.graph
    oridecon.graphql
    oridecon.http
    oridecon.mapping
    oridecon.middleware
    oridecon.monitor
    oridecon.nosql
    oridecon.notification
    oridecon.plugins
    oridecon.queue
    oridecon.resilience
    oridecon.search
    oridecon.security
    oridecon.serialization
    oridecon.sql
    oridecon.storage
    oridecon.tasks
    oridecon.testing
    oridecon.ui
    oridecon.validation
    oridecon.vector
    oridecon.web
    oridecon.workflow
    # AI family
    oridecon.ai
    # Multimedia family
    oridecon.multimedia
# ---------------------------------------------------------------------------
# TRACKED VIOLATIONS — to be fixed in feat/core-cleanup
# ---------------------------------------------------------------------------
# These imports violate the core/extension boundary but exist because
# core-draft-refactor.md explicitly identified them as coupling to resolve:
#
#   1. oridecon.config.base / oridecon.config.main / oridecon.logging.*
#      → oridecon.domain / oridecon.validation
#      Root cause: BaseConfig extends DomainModel; config.main + logging
#      config models use Field/ConfigDict/model_validator from validation.
#      Fix: Detangle BaseConfig from DomainModel; use pydantic directly
#      in logging/config models.
#      Tracked: cc-p3-transport-coupling
#
#   2. oridecon.app.standard → oridecon.serialization / oridecon.concurrency
#      Root cause: StandardApplication is the batteries-included module
#      that intentionally bundles SerializationProvider + ConcurrencyProvider.
#      Fix: Move StandardApplication to a wrapper package, or document as
#      the canonical batteries-included entry point.
#      Tracked: cc-p5-core-module
ignore_imports =
    # config coupling (tracked: cc-p3-transport-coupling)
    oridecon.config.base -> oridecon.domain
    oridecon.config.base -> oridecon.validation
    oridecon.config.main -> oridecon.validation
    # logging coupling (tracked: cc-p3-transport-coupling)
    oridecon.logging.config.sampling -> oridecon.domain
    oridecon.logging.config.sampling -> oridecon.validation
    oridecon.logging.config.models -> oridecon.validation
    oridecon.logging.config.redaction -> oridecon.domain
    oridecon.logging.config.redaction -> oridecon.validation
    # StandardApplication batteries-included bundle (tracked: cc-p5-core-module)
    oridecon.app.standard -> oridecon.serialization.di.provider
    oridecon.app.standard -> oridecon.concurrency.di.provider
unmatched_ignore_imports_alerting = warn

# =============================================================================
# Contract 3 — Foundational packages do not import from higher-level extensions
# =============================================================================
# The four Phase-8 foundational packages form a mid-tier that other extensions
# may depend on.  They must themselves remain clean — no imports from
# non-foundational extension packages, the AI family, or composite packages.

[importlinter:contract:foundational-no-high-level]
name = Foundational packages (domain/serialization/validation/concurrency) do not import from non-foundational extensions
type = forbidden
source_modules =
    oridecon.domain
    oridecon.serialization
    oridecon.validation
    oridecon.concurrency
forbidden_modules =
    oridecon.admin
    oridecon.auth
    oridecon.cache
    oridecon.cli
    oridecon.events
    oridecon.features
    oridecon.graph
    oridecon.graphql
    oridecon.http
    oridecon.mapping
    oridecon.middleware
    oridecon.monitor
    oridecon.nosql
    oridecon.notification
    oridecon.plugins
    oridecon.queue
    oridecon.resilience
    oridecon.search
    oridecon.security
    oridecon.sql
    oridecon.storage
    oridecon.tasks
    oridecon.testing
    oridecon.ui
    oridecon.vector
    oridecon.web
    oridecon.workflow
    # AI family
    oridecon.ai
    # Multimedia family
    oridecon.multimedia

# =============================================================================
# Contract 4 — Regular extension packages are independent of each other
# =============================================================================
# Extension packages (excluding composite packages, foundational packages,
# and the AI family — which have separate contracts) must not import from
# one another.
#
# Excluded from this independence check:
#   • Foundational (domain, serialization, validation, concurrency) — any
#     extension may import from them; they are not peers.
#   • Composite (admin, cli, testing, ai) — high-level packages that are
#     intentionally designed to compose multiple extensions.
#
# Documented ignore_imports:
#   • oridecon.web.** -> oridecon.ui.**  — documented exception (web renders
#     HTML using the UI layout components)
#   • oridecon.web.** -> oridecon.security.**  — TRACKED VIOLATION; web's
#     middleware.security imports oridecon.security config directly; this
#     should be refactored to route through oridecon.contracts so that
#     web has no direct extension dependency on security.
#   • oridecon.ai.** -> oridecon.ai.*  — orchestrator is allowed to import
#     sub-packages for composition and wiring.

[importlinter:contract:regular-extensions-independence]
name = Regular extension packages are independent of each other
type = independence
modules =
    oridecon.auth
    oridecon.cache
    oridecon.events
    oridecon.features
    oridecon.graph
    oridecon.graphql
    oridecon.http
    oridecon.mapping
    oridecon.middleware
    oridecon.monitor
    oridecon.nosql
    oridecon.notification
    oridecon.plugins
    oridecon.queue
    oridecon.resilience
    oridecon.search
    oridecon.security
    oridecon.sql
    oridecon.storage
    oridecon.tasks
    oridecon.ui
    oridecon.vector
    oridecon.web
    oridecon.workflow
ignore_imports =
    # Documented exception: web renders HTML using UI layout components
    oridecon.web.** -> oridecon.ui.**
    # Tracked violation: web security middleware imports security config
    # directly.  Refactor target: route through oridecon.contracts.
    # Filed as tech-debt: replace with a contracts-based interface boundary.
    oridecon.web.** -> oridecon.security.**
    # Tracked violation: ambient hashing (AGENTS.md) used from sql repositories
    # for cache-key derivation; same refactor target as the web entry.
    oridecon.sql.** -> oridecon.security.**
    # Owned by 2026-08-15-admin-contributor-refactor.md Phase 2 (WidgetContent),
    # executed before Step 6 of 2026-08-17-architecture-admin-auth-rbac-boundaries-design.md;
    # these entries are REMOVED by that plan's final task — do not remove here.
    oridecon.auth.** -> oridecon.ui
    oridecon.cache.** -> oridecon.ui
    oridecon.events.** -> oridecon.ui
    oridecon.queue.** -> oridecon.ui
    oridecon.sql.** -> oridecon.ui
    oridecon.tasks.** -> oridecon.ui
    oridecon.web.** -> oridecon.ui
    # Tracked violation: events/middleware/tasks use oridecon.resilience for
    # retry and rate-limiting utilities.  These were moved from oridecon.primitives
    # to oridecon.resilience (cc-p1).  Refactor target: promote retry and
    # TokenBucket to a foundational package (or contracts) so these extension
    # packages can remain independent.
    oridecon.events.** -> oridecon.resilience.**
    oridecon.middleware.** -> oridecon.resilience.**
    oridecon.tasks.** -> oridecon.resilience.**
    # Documented allowance: oridecon.ai is the orchestrator and is intentionally
    # allowed to import from its sub-packages for composition and wiring.
    oridecon.ai.** -> oridecon.ai.agents.**
    oridecon.ai.** -> oridecon.ai.feedback.**
    oridecon.ai.** -> oridecon.ai.governance.**
    oridecon.ai.** -> oridecon.ai.guard.**
    oridecon.ai.** -> oridecon.ai.llm.**
    oridecon.ai.** -> oridecon.ai.mcp.**
    oridecon.ai.** -> oridecon.ai.memory.**
    oridecon.ai.** -> oridecon.ai.observability.**
    oridecon.ai.** -> oridecon.ai.prompt.**
    oridecon.ai.** -> oridecon.ai.rag.**
    oridecon.ai.** -> oridecon.ai.session.**
    oridecon.ai.** -> oridecon.ai.skills.**
    oridecon.ai.** -> oridecon.vector.**
    oridecon.ai.** -> oridecon.ai.workers.**
    # Documented allowance: oridecon.ai imports oridecon.vector for
    # vector store integration and composition.
    oridecon.ai.** -> oridecon.vector.**
    # Documented allowance: oridecon.multimedia is the orchestrator and is
    # intentionally allowed to import from its sub-packages for composition
    # and wiring (mirrors the oridecon.ai allowance above).
    oridecon.multimedia.** -> oridecon.multimedia.beat.**
    oridecon.multimedia.** -> oridecon.multimedia.image.**
    oridecon.multimedia.** -> oridecon.multimedia.interpolate.**
    oridecon.multimedia.** -> oridecon.multimedia.music.**
    oridecon.multimedia.** -> oridecon.multimedia.tts.**
    oridecon.multimedia.** -> oridecon.multimedia.upscale.**
    oridecon.multimedia.** -> oridecon.multimedia.video.**
unmatched_ignore_imports_alerting = warn

# =============================================================================
# Contract 5 — AI sub-packages are independent of each other
# =============================================================================
# Per AGENTS.md: "oridecon.ai.* packages do NOT import from each other".
# The AI parent package (oridecon.ai) acts as the orchestrator/facade and
# is intentionally excluded from this independence list — it IS allowed to
# import from sub-packages to wire them together.
#
# oridecon.tasks is listed as a peer so AI sub-packages can never import
# the tasks implementation directly — cross-extension communication goes
# through oridecon.contracts.infra.tasks protocols (audit finding §51,
# 2026-08-18-architecture-ai-governance-tasks-import-design.md).

[importlinter:contract:ai-sub-independence]
name = AI sub-packages do not import from each other or from oridecon.tasks
type = independence
modules =
    oridecon.ai.agents
    oridecon.ai.evaluation
    oridecon.ai.feedback
    oridecon.ai.governance
    oridecon.ai.guard
    oridecon.ai.llm
    oridecon.ai.mcp
    oridecon.ai.memory
    oridecon.ai.observability
    oridecon.ai.prompt
    oridecon.ai.rag
    oridecon.ai.session
    oridecon.ai.skills
    oridecon.vector
    oridecon.ai.workers
    oridecon.tasks

# =============================================================================
# Contract 5b — Multimedia sub-packages are independent of each other
# =============================================================================
# Mirrors Contract 5 (ai-sub-independence). The multimedia parent package
# (oridecon.multimedia) acts as the orchestrator/facade and is intentionally
# excluded from this independence list — it IS allowed to import from
# sub-packages to wire them together. Per each sub-package's own docstrings
# (e.g. video_upscale_service.py: "never a direct import of
# oridecon-multimedia-video (design spec §4.3)"), siblings must depend on
# each other only through oridecon-contracts protocols.

[importlinter:contract:multimedia-sub-independence]
name = Multimedia sub-packages do not import from each other
type = independence
modules =
    oridecon.multimedia.beat
    oridecon.multimedia.image
    oridecon.multimedia.interpolate
    oridecon.multimedia.music
    oridecon.multimedia.tts
    oridecon.multimedia.upscale
    oridecon.multimedia.video

# =============================================================================
# Contract 6 — AI sub-packages do not import from the AI parent (oridecon.ai)
# =============================================================================
# Per AGENTS.md: "oridecon.ai.* packages … do NOT import from oridecon.ai".
# Sub-packages must not reach back up to the orchestrator layer.
#
# NOTE: A dedicated forbidden contract cannot be expressed here due to a
# grimp limitation: when checking "oridecon.ai.agents cannot import from
# oridecon.ai", grimp raises "Modules have shared descendants" because
# oridecon.ai.agents is itself a descendant of oridecon.ai — grimp cannot
# perform ancestor-as-forbidden checks.
#
# Enforcement strategy:
#   1. Verified clean at Phase 8 setup — grep confirms zero sub→parent imports.
#   2. Contract 5 (ai-sub-independence) already prevents cross-sub-package
#      pollution which would be the main surface for back-channel parent access.
#   3. Any future oridecon.ai.* → oridecon.ai import will be caught by code
#      review and the mypy --no-implicit-reexport discipline.
#
# To manually verify:
#   grep -rn "from oridecon.ai import\|import oridecon.ai$" \
#     oridecon-ai-*/src/oridecon/ai/

# =============================================================================
# Contract 7 — Local protocol modules are package-internal seams only
# =============================================================================
# Per guide docs/oridecon-docs/guides/contracts.md (R4): a package-local
# protocols.py exists for internal implementation seams and must never be
# imported across packages.  Cross-package sharing requires promoting the
# protocol into oridecon-contracts (R1/R2).  Imports by the owning package
# itself are permitted (wildcard ** matches zero or more submodules).
#
# Excluded from the forbidden list: oridecon.ui.protocols (RenderableProtocol)
# is reachable only through the oridecon.ui package, which other packages
# (web/admin/admin pages) legitimately import under documented allowances.
# Forbidden checks are chain-based, and import-linter has no "direct imports
# only" mode, so ui.protocols is reviewed by grep instead of this contract.

[importlinter:contract:local-protocols-scoped]
name = Local protocol modules are package-internal seams (no cross-package imports)
type = forbidden
source_modules =
    # Core
    oridecon.app
    oridecon.config
    oridecon.primitives
    oridecon.di
    oridecon.logging
    oridecon.result
    # Extension packages (owners of the forbidden modules below are
    # excluded; their intra-package usage is allowed)
    oridecon.auth
    oridecon.cache
    oridecon.concurrency
    oridecon.domain
    oridecon.events
    oridecon.features
    oridecon.graph
    oridecon.graphql
    oridecon.http
    oridecon.mapping
    oridecon.middleware
    oridecon.monitor
    oridecon.nosql
    oridecon.notification
    oridecon.queue
    oridecon.resilience
    oridecon.search
    oridecon.security
    oridecon.serialization
    oridecon.sql
    oridecon.storage
    oridecon.tasks
    oridecon.testing
    oridecon.validation
    oridecon.vector
    oridecon.web
    oridecon.workflow
forbidden_modules =
    oridecon.ai.llm.protocols
    oridecon.ai.agents.protocols
    oridecon.ai.agents.speculation.protocols
    oridecon.ai.memory.protocols
    oridecon.cli.protocols
    oridecon.admin.auth.protocols
    oridecon.admin.auth.store.protocols
ignore_imports =
    # Owner-package usage only — intra-package seam imports are allowed
    oridecon.ai.llm.** -> oridecon.ai.llm.protocols
    oridecon.ai.agents -> oridecon.ai.agents.protocols
    oridecon.ai.agents.speculation.** -> oridecon.ai.agents.speculation.protocols
    oridecon.ai.memory -> oridecon.ai.memory.protocols
    oridecon.cli.** -> oridecon.cli.protocols
    oridecon.admin.** -> oridecon.admin.auth.protocols
    oridecon.admin.** -> oridecon.admin.auth.store.protocols

# =============================================================================
# Contract 8 — oridecon.admin imports only its allowed dependency set
# =============================================================================
# Admin is a high-level composite.  Per AGENTS.md §1.2 it may import from:
#   * core namespaces (oridecon.app, oridecon.config, oridecon.di, ...),
#   * oridecon.contracts,
#   * documented exceptions: oridecon.auth, oridecon.cache, oridecon.features,
#     oridecon.resilience, oridecon.ui.
# Everything else is forbidden — cross-subsystem imports must route through
# contracts or the container.

[importlinter:contract:admin-import-allowlist]
name = oridecon.admin imports only its allowed dependency set
type = forbidden
source_modules =
    oridecon.admin
forbidden_modules =
    oridecon.ai
    oridecon.cli
    oridecon.events
    oridecon.graph
    oridecon.graphql
    oridecon.http
    oridecon.monitor
    oridecon.multimedia
    oridecon.nosql
    oridecon.notification
    oridecon.queue
    oridecon.search
    oridecon.sql
    oridecon.storage
    oridecon.tasks
    oridecon.testing
    oridecon.vector
    oridecon.web
    oridecon.workflow

# =============================================================================
# Contract 9 — oridecon.auth must not import oridecon.admin (auth ⊥ admin)
# =============================================================================
# The panel delegates to auth, never the reverse: prevents an admin<->auth
# cycle and keeps oridecon-auth reusable without the dashboard layer.

[importlinter:contract:auth-banned-from-admin]
name = oridecon.auth must not import oridecon.admin
type = forbidden
source_modules =
    oridecon.auth
forbidden_modules =
    oridecon.admin
