# Oridecon Framework full environment configuration example.
#
# Copy to .env and adjust values for your deployment:
#   cp .env.full.example .env
#
# Generated from docs/reference/REF_ENV_VARS.md by
# dev/generators/env_example.py — do not edit by hand.
#
# All variables are optional unless noted: every config value carries a
# code default, so an unset variable falls back to framework defaults.
#
# Critical secrets MUST be set in production:
#   * any value shown as <change-me-in-production>
#   * provider API keys (OpenAI, Anthropic, Google, ...) supplied through
#     your secrets manager or *_SECRET_NAME references

# ── oridecon ──
DEBUG=false  # — (str)
ORIDECON__APP_NAME=oridecon-app  # Application name (str)
ORIDECON__DEBUG=false  # Enable debug mode. Also toggled by the DEBUG env var. (bool)
ORIDECON__DISCOVERY__AUTO_DISCOVER=false  # — (bool)
ORIDECON__DISCOVERY__DIRECTORIES=  # — (list[str])
ORIDECON__DISCOVERY__DISABLED_MODULES=  # — (list[str])
ORIDECON__DISCOVERY__ENABLED_MODULES=  # — (list[str])
ORIDECON__DISCOVERY__ENTRY_POINT_GROUP=oridecon.modules  # — (str)
ORIDECON__ENV=Environment.DEVELOPMENT  # Deployment environment (development, staging, production, test). (Environment)
ORIDECON__HEALTH__CHECK_TIMEOUT=DEFAULT_HEALTH_CHECK_TIMEOUT  # — (float)
ORIDECON__HEALTH__INCLUDE_DETAILS=true  # — (bool)
ORIDECON__LOGGING__JSON_FORMAT=false  # JSON log format (bool)
ORIDECON__LOGGING__LEVEL=INFO  # Global log level (str)
ORIDECON__LOGGING__LEVELS=  # Per-logger level overrides (dict[str, str])
ORIDECON__LOGGING__REDACTION__ENABLED=true  # — (bool)
ORIDECON__LOGGING__REDACTION__FIELD_DENYLIST=  # — (tuple[str, ...])
